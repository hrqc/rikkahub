<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The fixture belongs to the test APK and has no network capability. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <application>
        <activity
            android:name="me.rerere.rikkahub.data.mobileagent.fixture.PhoneFixtureActivity"
            android:exported="true"
            android:label="Mobile Agent Test Fixture"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:windowSoftInputMode="stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="me.rerere.rikkahub.data.mobileagent.fixture.PhoneFixtureSecondActivity"
            android:exported="true"
            android:label="Mobile Agent Test Fixture Second Page"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    </application>
</manifest>
